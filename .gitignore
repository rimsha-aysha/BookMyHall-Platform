# Secrets — never commit (server/.env holds the Atlas password and JWT secret)
.env
.env.*
!.env.example

node_modules/
dist/
server/uploads/
*.log

# Per-restaurant setup files (contact details etc.) stay out of Git; only the
# placeholder example is committed. They never contain passwords.
server/setup/*.json
!server/setup/restaurant.example.json
# Per-restaurant environment files used with --env-file (contain credentials).
server/setup/*.env
