PORT=5000
NODE_ENV=development

# MongoDB connection string for THIS project's own database — never the
# original BookMyHall database (see src/config/dbGuard.js). For local
# development: mongodb://localhost:27017/bookmyhall_platform
MONGODB_URI=mongodb+srv://<user>:<password>@<new-cluster>.mongodb.net/bookmyhall_platform?retryWrites=true&w=majority
# Must match the database name in MONGODB_URI, or the server refuses to start.
MONGODB_DB_NAME=bookmyhall_platform
# Optional, comma-separated: hosts that must never be used from this project
# (e.g. the original project's cluster host). Keep real hosts out of Git.
MONGODB_BLOCKED_HOSTS=

# JWT — production: a random string of at least 32 characters, unique per installation
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# This installation's website address(es) allowed to call the API (CORS).
# Production: https:// with no path; comma-separate several (e.g. with www.).
CLIENT_URL=http://localhost:5173

# Cloudinary (image uploads) — from the Cloudinary Console dashboard.
# Required in production. Locally, leave empty to store uploads in server/uploads.
# ALLOW_LOCAL_UPLOADS=true lets production use local disk — only on a persistent disk.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Required with Cloudinary: this restaurant's own upload folder, e.g.
# bookmyhall-platform/spice-garden — never shared between installations.
CLOUDINARY_FOLDER=

# Razorpay — TEST MODE keys only (Dashboard > Account & Settings > API Keys, in Test Mode).
# The Key ID is sent to the browser to open Checkout; the secret never leaves the server.
# Never put the secret in a VITE_ variable.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
