PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (include the database name, /bookmyhall)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookmyhall?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API (CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (image uploads) — from the Cloudinary Console dashboard.
# Leave empty to keep storing uploads on local disk (server/uploads).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay — TEST MODE keys only (Dashboard > Account & Settings > API Keys, in Test Mode).
# The Key ID is sent to the browser to open Checkout; the secret never leaves the server.
# Never put the secret in a VITE_ variable.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
